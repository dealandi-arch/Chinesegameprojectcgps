DATABASE_URL="file:./dev.db"

# Secret used to sign/encrypt session cookies. Must be 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32+-character-string"

# Code entered on the "Create Profile" form to become an admin.
# Set the real value in your local .env (never commit it).
ADMIN_CODE="replace-with-your-admin-code"
