# From your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-key"

# Service role key. Bypasses all security rules -- server-only, never
# commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# Code entered on the "Create Profile" form to become an admin.
# Set the real value in your local .env (never commit it).
ADMIN_CODE="replace-with-your-admin-code"

# Code entered on the same "Create Profile" field to become a SUPER admin:
# an admin who can also delete staff chat messages. Leave unset to disable
# super-admin signup entirely (you can still grant the flag by hand with
# supabase/promote_super_admin.sql).
SUPER_ADMIN_CODE="replace-with-your-super-admin-code"
